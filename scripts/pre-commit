#!/bin/sh
# scripts/pre-commit

# Run spotlessApply
changed_java_files=$(git diff --cached --name-only -- 'assessment-service/src/*/java/**/*.java')
if [ -n "$changed_java_files" ]; then
  echo "Running Spotless Apply..."
  ./gradlew :assessment-service:spotlessApply

  # Re-add only the staged Java files (avoid sweeping in unrelated changes)
  printf '%s\n' "$changed_java_files" | while IFS= read -r file; do
    [ -n "$file" ] && git add -- "$file"
  done
fi
